@model AvatarViewModel

<img src="@Url.Content(ViewBag.AvatarUrl)" alt="Profile Picture" width="200px"/>
<form asp-controller="User" asp-action="UploadAvatar" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <label asp-for="AvatarFile" class="control-label"></label>
        <input asp-for="AvatarFile" class="form-control"/>
        <span asp-validation-for="AvatarFile" class="text-danger"></span>
        <button type="submit" class="btn btn-primary">
            Upload avatar
        </button>
    
</form>

